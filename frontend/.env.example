# Backend API & WebSocket URLs (Points to Render production service, e.g., https://holocollab.onrender.com)
VITE_API_URL=http://localhost:8000
VITE_SOCKET_URL=http://localhost:8000

# WebRTC STUN / TURN Server Configuration (e.g., from Open Relay or Metered Video)
VITE_TURN_URL=turn:openrelay.metered.ca:80
VITE_TURN_USER=openrelayproject
VITE_TURN_PASS=openrelayproject
