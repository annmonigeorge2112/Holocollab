# Application environment: development | production | test
ENVIRONMENT=development

# Database (Postgres on Neon: postgresql+asyncpg://<user>:<password>@<host>/<db>?ssl=require)
DATABASE_URL=sqlite+aiosqlite:///./holocollab.db

# Authentication (Minimum 32 random characters; app refuses to start with default in production)
JWT_SECRET=replace_with_a_secure_jwt_secret_min_32_chars

# Google Gemini (Server-side only)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Storage Backend: 'local' for dev or 'supabase' for production
STORAGE_BACKEND=local
SUPABASE_URL=
SUPABASE_KEY=
SUPABASE_BUCKET=models
BASE_URL=http://localhost:8000
UPLOADS_DIR=uploads

# Allowed Origins for CORS and WebSocket (Comma-separated in production)
FRONTEND_ORIGIN=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
